{
  "name": "douane-saas-server",
  "version": "1.0.0",
  "private": true,
  "description": "API Express/MongoDB pour les données douanières Eurostat (Comext) par code NC",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/scripts/seed.js",
    "import:eurostat": "node src/scripts/importEurostat.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "nc:sync": "node src/scripts/ncSync.js",
    "update": "node src/scripts/update.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
