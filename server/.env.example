PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017/douane_saas
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Jeu de données Comext (DS-045409 : commerce UE depuis 1988 par NC8)
EUROSTAT_DATASET=DS-045409
EUROSTAT_BASE_URL=https://ec.europa.eu/eurostat/api/comext/dissemination/statistics/1.0/data

# Fichiers bulk Eurostat (source principale de la base ; l'API n'est plus utilisée par défaut)
EUROSTAT_BULK_FROM=2015-01
# EUROSTAT_BULK_PATTERNS=full_v2_{YYYYMM}.7z,full{YYYYMM}.7z
# EUROSTAT_BULK_DIR=data/bulk
# EUROSTAT_BULK_KEEP=false
# EUROSTAT_CN_LABELS_URL=
# Mise à jour automatique
AUTO_UPDATE=false
UPDATE_EUROSTAT_BULK=true
UPDATE_EUROSTAT_API=false
